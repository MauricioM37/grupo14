# Copy this file to .env locally and replace placeholders with private values.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&sslmode=require"
ADMIN_BEARER_TOKEN="replace-with-a-long-random-secret"
DATA_ENCRYPTION_KEY="replace-with-32-byte-base64-key"
NUMBER_HMAC_KEY="replace-with-a-long-random-hmac-key"
PDF_STORAGE_PATH="./.data/private-pdfs"
DIRECT_CONTEXT_MAX_CHARS="80000"
MIN_EXTRACTED_CHARS="80"
CONSENT_TEXT_VERSION="v1"
CONSENT_TEXT="Acepto recibir consultas ciudadanas no vinculantes por WhatsApp, con una frecuencia limitada. Mi número se protege y puedo cancelar los mensajes en cualquier momento respondiendo BAJA."

GROQ_API_KEY=""
GROQ_CHAT_MODEL="llama-3.3-70b-versatile"

WHATSAPP_ENABLED="false"
WHATSAPP_FAKE="false"
WHATSAPP_SESSION_PATH="./.data/whatsapp-session"

PORT="3000"
NODE_ENV="development"
